{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gentle-ai.dev/contracts/work-routing/v1/schemas/diagnostic.schema.json",
  "title": "Gentle AI work routing diagnostic v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "operation",
    "code",
    "message",
    "requestedContract",
    "supportedContracts",
    "mutationOutcome",
    "nextAction"
  ],
  "properties": {
    "schema": {"const": "gentle-ai.work-diagnostic/v1"},
    "operation": {
      "enum": [
        "work.capabilities",
        "work.start",
        "work.route",
        "work.advance",
        "work.reconcile",
        "work.status",
        "work.transition.apply"
      ]
    },
    "code": {
      "enum": ["unsupported_contract", "outcome_not_managed"]
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[^\\x00\\x09-\\x0D\\x20\u0085\u00A0\u1680\u2000-\u200A\u2028\u2029\u202F\u205F\u3000\uFEFF](?:[^\\r\\n\\x00]*[^\\x00\\x09-\\x0D\\x20\u0085\u00A0\u1680\u2000-\u200A\u2028\u2029\u202F\u205F\u3000\uFEFF])?$"
    },
    "requestedContract": {"type": "string", "maxLength": 240},
    "supportedContracts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "gentle-ai.work-capabilities/v1",
          "gentle-ai.work-start/v1",
          "gentle-ai.work-route/v1",
          "gentle-ai.work-advance/v1",
          "gentle-ai.work-reconcile/v1",
          "gentle-ai.work-status/v1",
          "gentle-ai.work-transition/v1"
        ]
      }
    },
    "mutationOutcome": {"const": "not_started"},
    "nextAction": {
      "enum": ["select_supported_contract", "continue_unmanaged"]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"code": {"const": "unsupported_contract"}}
      },
      "then": {
        "properties": {
          "nextAction": {"const": "select_supported_contract"}
        }
      }
    },
    {
      "if": {
        "properties": {"code": {"const": "outcome_not_managed"}}
      },
      "then": {
        "properties": {
          "operation": {"const": "work.start"},
          "requestedContract": {"const": "gentle-ai.work-start/v1"},
          "supportedContracts": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "prefixItems": [
              {"const": "gentle-ai.work-start/v1"}
            ]
          },
          "nextAction": {"const": "continue_unmanaged"}
        }
      }
    }
  ]
}
