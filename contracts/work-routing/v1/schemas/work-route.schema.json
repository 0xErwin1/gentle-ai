{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gentle-ai.dev/contracts/work-routing/v1/schemas/work-route.schema.json",
  "title": "Gentle AI owner-controlled work route mutation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "contract",
    "operation",
    "previousRevision",
    "selectedRoute",
    "status"
  ],
  "properties": {
    "schema": {"const": "gentle-ai.work-route/v1"},
    "contract": {"const": "gentle-ai.work-route/v1"},
    "operation": {"enum": ["decide", "bind-sdd"]},
    "choice": {"enum": ["accept_sdd", "decline_sdd"]},
    "previousRevision": {"$ref": "#/$defs/revision"},
    "selectedRoute": {
      "enum": ["direct_inline", "delegated_direct", "sdd"]
    },
    "status": {
      "allOf": [
        {"$ref": "work-status.schema.json"},
        {
          "required": ["deliveryIntentRef"],
          "properties": {
            "publicState": {"const": "working"},
            "verification": {
              "properties": {
                "outcome": {"const": "pending"},
                "resultRefs": {"maxItems": 0}
              }
            }
          },
          "not": {
            "anyOf": [
              {"required": ["reviewReceiptRef"]},
              {"required": ["diagnostic"]},
              {"required": ["authorizedTransition"]}
            ]
          }
        }
      ]
    }
  },
  "oneOf": [
    {
      "properties": {
        "operation": {"const": "decide"},
        "choice": {"const": "accept_sdd"},
        "selectedRoute": {"const": "sdd"},
        "status": {
          "allOf": [
            {"$ref": "work-status.schema.json"},
            {
              "properties": {
                "publicState": {"const": "working"},
                "routeDecision": {"const": "propose_sdd"},
                "routePhase": {"const": "sdd_runtime_pending"}
              },
              "not": {
                "anyOf": [
                  {"required": ["implementationRoute"]},
                  {"required": ["sddRunRef"]},
                  {"required": ["authorizedTransition"]}
                ]
              }
            }
          ]
        }
      },
      "required": ["choice"]
    },
    {
      "properties": {
        "operation": {"const": "decide"},
        "choice": {"const": "decline_sdd"},
        "selectedRoute": {"const": "direct_inline"},
        "status": {
          "allOf": [
            {"$ref": "work-status.schema.json"},
            {
              "properties": {
                "routeDecision": {"const": "direct_inline"},
                "routePhase": {"const": "implementation_selected"},
                "implementationRoute": {"const": "direct_inline"}
              },
              "not": {"required": ["authorizedTransition"]}
            }
          ]
        }
      },
      "required": ["choice"]
    },
    {
      "properties": {
        "operation": {"const": "decide"},
        "choice": {"const": "decline_sdd"},
        "selectedRoute": {"const": "delegated_direct"},
        "status": {
          "allOf": [
            {"$ref": "work-status.schema.json"},
            {
              "properties": {
                "routeDecision": {"const": "delegated_direct"},
                "routePhase": {"const": "implementation_selected"},
                "implementationRoute": {"const": "delegated_direct"}
              },
              "not": {"required": ["authorizedTransition"]}
            }
          ]
        }
      },
      "required": ["choice"]
    },
    {
      "properties": {
        "operation": {"const": "bind-sdd"},
        "selectedRoute": {"const": "sdd"},
        "status": {
          "allOf": [
            {"$ref": "work-status.schema.json"},
            {
              "required": ["implementationRoute", "sddRunRef"],
              "properties": {
                "routeDecision": {"const": "propose_sdd"},
                "routePhase": {"const": "implementation_selected"},
                "implementationRoute": {"const": "sdd"}
              },
              "not": {"required": ["authorizedTransition"]}
            }
          ]
        }
      },
      "not": {"required": ["choice"]}
    }
  ],
  "$defs": {
    "revision": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
