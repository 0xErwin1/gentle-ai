{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gentle-ai.dev/contracts/work-routing/v1/schemas/work-transition.schema.json",
  "title": "Gentle AI authorized work transition result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "contract",
    "workRunId",
    "previousRevision",
    "revision",
    "appliedAuthorizationRef",
    "publicState"
  ],
  "properties": {
    "schema": {"const": "gentle-ai.work-transition/v1"},
    "contract": {"const": "gentle-ai.work-transition/v1"},
    "workRunId": {"$ref": "#/$defs/ref"},
    "previousRevision": {"$ref": "#/$defs/revision"},
    "revision": {"$ref": "#/$defs/revision"},
    "appliedAuthorizationRef": {"$ref": "#/$defs/ref"},
    "publicState": {
      "enum": ["working", "checking", "ready", "needs_your_decision"]
    },
    "nextAuthorizedTransition": {"$ref": "#/$defs/authorizedTransition"}
  },
  "$defs": {
    "revision": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[^\\x00\\x09-\\x0D\\x20\u0085\u00A0\u1680\u2000-\u200A\u2028\u2029\u202F\u205F\u3000\uFEFF](?:[^\\r\\n\\x00]*[^\\x00\\x09-\\x0D\\x20\u0085\u00A0\u1680\u2000-\u200A\u2028\u2029\u202F\u205F\u3000\uFEFF])?$"
    },
    "authorizedTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "operation",
        "authorizationRef",
        "expectedRevision",
        "candidateRef",
        "actionTicketRef",
        "applicableAuthorizationRef"
      ],
      "properties": {
        "contract": {"const": "gentle-ai.work-transition/v1"},
        "operation": {"const": "apply"},
        "authorizationRef": {"$ref": "#/$defs/ref"},
        "expectedRevision": {"$ref": "#/$defs/revision"},
        "candidateRef": {"$ref": "#/$defs/ref"},
        "actionTicketRef": {"$ref": "#/$defs/ref"},
        "applicableAuthorizationRef": {"$ref": "#/$defs/ref"}
      }
    }
  }
}
