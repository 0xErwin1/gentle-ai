{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gentle-ai.dev/contracts/work-routing/v1/schemas/work-reconcile.schema.json",
  "title": "Gentle AI one-shot productive reconciliation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "contract",
    "previousRevision",
    "diagnosticRef",
    "reconciliationRef",
    "outcome",
    "status"
  ],
  "properties": {
    "schema": {"const": "gentle-ai.work-reconcile/v1"},
    "contract": {"const": "gentle-ai.work-reconcile/v1"},
    "previousRevision": {"$ref": "#/$defs/revision"},
    "diagnosticRef": {"$ref": "#/$defs/revision"},
    "reconciliationRef": {"$ref": "#/$defs/revision"},
    "outcome": {
      "enum": [
        "delivery_confirmed",
        "no_delivery_confirmed",
        "manual_resolution_required"
      ]
    },
    "status": {
      "allOf": [
        {"$ref": "work-status.schema.json"},
        {"not": {"required": ["authorizedTransition"]}}
      ]
    },
    "deliveryResultRef": {"$ref": "#/$defs/revision"}
  },
  "oneOf": [
    {
      "properties": {
        "outcome": {"const": "delivery_confirmed"},
        "status": {
          "allOf": [
            {"$ref": "work-status.schema.json"},
            {
              "properties": {"publicState": {"const": "ready"}},
              "not": {
                "anyOf": [
                  {"required": ["diagnostic"]},
                  {"required": ["authorizedTransition"]}
                ]
              }
            }
          ]
        }
      },
      "required": ["deliveryResultRef"]
    },
    {
      "properties": {
        "outcome": {"const": "no_delivery_confirmed"},
        "status": {
          "allOf": [
            {"$ref": "work-status.schema.json"},
            {
              "required": ["diagnostic"],
              "properties": {
                "publicState": {"const": "needs_your_decision"},
                "diagnostic": {
                  "properties": {
                    "code": {"const": "delivery_not_completed"},
                    "nextAction": {"const": "start_fresh_work_run"}
                  }
                }
              },
              "not": {"required": ["authorizedTransition"]}
            }
          ]
        }
      },
      "not": {"required": ["deliveryResultRef"]}
    },
    {
      "properties": {
        "outcome": {"const": "manual_resolution_required"},
        "status": {
          "allOf": [
            {"$ref": "work-status.schema.json"},
            {
              "required": ["diagnostic"],
              "properties": {
                "publicState": {"const": "needs_your_decision"},
                "diagnostic": {
                  "properties": {
                    "code": {
                      "const": "delivery_manual_resolution_required"
                    },
                    "nextAction": {
                      "const": "manual_delivery_resolution_required"
                    }
                  }
                }
              },
              "not": {"required": ["authorizedTransition"]}
            }
          ]
        }
      },
      "not": {"required": ["deliveryResultRef"]}
    }
  ],
  "$defs": {
    "revision": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
