{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gentle-ai.dev/contracts/work-routing/v1/schemas/work-advance.schema.json",
  "title": "Gentle AI bounded productive work advance v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "contract",
    "previousRevision",
    "status"
  ],
  "properties": {
    "schema": {
      "const": "gentle-ai.work-advance/v1"
    },
    "contract": {
      "const": "gentle-ai.work-advance/v1"
    },
    "previousRevision": {
      "$ref": "#/$defs/revision"
    },
    "status": {
      "allOf": [
        {
          "$ref": "work-status.schema.json"
        },
        {
          "not": {
            "required": [
              "authorizedTransition"
            ]
          }
        }
      ]
    },
    "deliveryResultRef": {
      "$ref": "#/$defs/revision"
    },
    "diagnostic": {
      "$ref": "#/$defs/initialDiagnostic"
    }
  },
  "oneOf": [
    {
      "required": [
        "deliveryResultRef"
      ],
      "not": {
        "required": [
          "diagnostic"
        ]
      },
      "properties": {
        "status": {
          "allOf": [
            {
              "$ref": "work-status.schema.json"
            },
            {
              "properties": {
                "publicState": {
                  "const": "ready"
                }
              },
              "not": {
                "required": [
                  "diagnostic"
                ]
              }
            }
          ]
        }
      }
    },
    {
      "required": [
        "diagnostic"
      ],
      "not": {
        "required": [
          "deliveryResultRef"
        ]
      },
      "properties": {
        "status": {
          "allOf": [
            {
              "$ref": "work-status.schema.json"
            },
            {
              "properties": {
                "publicState": {
                  "const": "needs_your_decision"
                },
                "diagnostic": {
                  "$ref": "#/$defs/initialDiagnostic"
                }
              },
              "required": [
                "diagnostic"
              ]
            }
          ]
        }
      }
    }
  ],
  "$defs": {
    "initialDiagnostic": {
      "allOf": [
        {
          "$ref": "work-advance-diagnostic.schema.json"
        },
        {
          "properties": {
            "code": {
              "not": {
                "enum": [
                  "delivery_not_completed",
                  "delivery_manual_resolution_required"
                ]
              }
            }
          }
        }
      ]
    },
    "revision": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
