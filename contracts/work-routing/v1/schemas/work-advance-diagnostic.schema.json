{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gentle-ai.dev/contracts/work-routing/v1/schemas/work-advance-diagnostic.schema.json",
  "title": "Gentle AI productive terminal diagnostic v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ref",
    "code",
    "message",
    "nextAction"
  ],
  "properties": {
    "ref": {
      "$ref": "#/$defs/revision"
    },
    "code": {
      "type": "string",
      "enum": [
        "candidate_base_not_git",
        "candidate_not_committed",
        "no_mutation",
        "candidate_wrong_base",
        "scope_mismatch",
        "candidate_changed_during_advance",
        "verification_applicability_unknown",
        "complete_verification_plan_required",
        "review_risk_unknown",
        "review_lenses_unknown",
        "complete_review_required",
        "delivery_decision_unavailable",
        "delivery_authorization_unavailable",
        "delivery_authorization_expired",
        "delivery_conflict",
        "delivery_effect_failed",
        "delivery_outcome_indeterminate",
        "provider_authority_unavailable",
        "delivery_not_completed",
        "delivery_manual_resolution_required"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[^\\x00\\r\\n]+$"
    },
    "nextAction": {
      "enum": [
        "start_fresh_work_run",
        "reconcile_before_new_work",
        "manual_delivery_resolution_required"
      ]
    }
  },
  "oneOf": [
    {
      "properties": {
        "code": {
          "const": "candidate_base_not_git"
        },
        "message": {
          "const": "The admitted START base is not an exact Git commit."
        },
        "nextAction": {
          "const": "start_fresh_work_run"
        }
      }
    },
    {
      "properties": {
        "code": {
          "const": "candidate_not_committed"
        },
        "message": {
          "const": "Commit the candidate and leave the worktree clean before advancing."
        },
        "nextAction": {
          "const": "start_fresh_work_run"
        }
      }
    },
    {
      "properties": {
        "code": {
          "const": "no_mutation"
        },
        "message": {
          "const": "The committed candidate contains no admitted change."
        },
        "nextAction": {
          "const": "start_fresh_work_run"
        }
      }
    },
    {
      "properties": {
        "code": {
          "const": "candidate_wrong_base"
        },
        "message": {
          "const": "The candidate HEAD is not a descendant of the admitted START base."
        },
        "nextAction": {
          "const": "start_fresh_work_run"
        }
      }
    },
    {
      "properties": {
        "code": {
          "const": "scope_mismatch"
        },
        "message": {
          "const": "The committed candidate paths differ from the exact admitted scope."
        },
        "nextAction": {
          "const": "start_fresh_work_run"
        }
      }
    },
    {
      "properties": {
        "code": {
          "const": "candidate_changed_during_advance"
        },
        "message": {
          "const": "The committed candidate changed while the owner was advancing it."
        },
        "nextAction": {
          "const": "start_fresh_work_run"
        }
      }
    },
    {
      "properties": {
        "code": {
          "const": "verification_applicability_unknown"
        },
        "message": {
          "const": "Verification applicability could not be established safely."
        },
        "nextAction": {
          "const": "start_fresh_work_run"
        }
      }
    },
    {
      "properties": {
        "code": {
          "const": "complete_verification_plan_required"
        },
        "message": {
          "const": "This candidate requires a complete verification plan."
        },
        "nextAction": {
          "const": "start_fresh_work_run"
        }
      }
    },
    {
      "properties": {
        "code": {
          "const": "review_risk_unknown"
        },
        "message": {
          "const": "Review risk could not be established safely."
        },
        "nextAction": {
          "const": "start_fresh_work_run"
        }
      }
    },
    {
      "properties": {
        "code": {
          "const": "review_lenses_unknown"
        },
        "message": {
          "const": "Required review lenses could not be established safely."
        },
        "nextAction": {
          "const": "start_fresh_work_run"
        }
      }
    },
    {
      "properties": {
        "code": {
          "const": "complete_review_required"
        },
        "message": {
          "const": "This candidate requires a complete review."
        },
        "nextAction": {
          "const": "start_fresh_work_run"
        }
      }
    },
    {
      "properties": {
        "code": {
          "const": "delivery_decision_unavailable"
        },
        "message": {
          "const": "A delivery decision could not be established safely."
        },
        "nextAction": {
          "const": "start_fresh_work_run"
        }
      }
    },
    {
      "properties": {
        "code": {
          "const": "delivery_authorization_unavailable"
        },
        "message": {
          "const": "A delivery authorization could not be established safely."
        },
        "nextAction": {
          "enum": [
            "start_fresh_work_run",
            "reconcile_before_new_work"
          ]
        }
      }
    },
    {
      "properties": {
        "code": {
          "const": "delivery_authorization_expired"
        },
        "message": {
          "const": "The delivery authorization expired before its first effect."
        },
        "nextAction": {
          "const": "start_fresh_work_run"
        }
      }
    },
    {
      "properties": {
        "code": {
          "const": "delivery_conflict"
        },
        "message": {
          "const": "The delivery destination changed or rejected the admitted candidate."
        },
        "nextAction": {
          "const": "start_fresh_work_run"
        }
      }
    },
    {
      "properties": {
        "code": {
          "const": "delivery_effect_failed"
        },
        "message": {
          "const": "The authorized delivery effect completed without delivering the candidate."
        },
        "nextAction": {
          "const": "start_fresh_work_run"
        }
      }
    },
    {
      "properties": {
        "code": {
          "const": "delivery_outcome_indeterminate"
        },
        "message": {
          "const": "The delivery effect may have started, but its terminal outcome is not provable."
        },
        "nextAction": {
          "const": "reconcile_before_new_work"
        }
      }
    },
    {
      "properties": {
        "code": {
          "const": "provider_authority_unavailable"
        },
        "message": {
          "const": "Required owner authority is unavailable; no additional effect was started."
        },
        "nextAction": {
          "enum": [
            "start_fresh_work_run",
            "reconcile_before_new_work"
          ]
        }
      }
    },
    {
      "properties": {
        "code": {
          "const": "delivery_not_completed"
        },
        "message": {
          "const": "Reconciliation proved that the candidate was not delivered."
        },
        "nextAction": {
          "const": "start_fresh_work_run"
        }
      }
    },
    {
      "properties": {
        "code": {
          "const": "delivery_manual_resolution_required"
        },
        "message": {
          "const": "Delivery remains indeterminate after owner reconciliation."
        },
        "nextAction": {
          "const": "manual_delivery_resolution_required"
        }
      }
    }
  ],
  "$defs": {
    "revision": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
