FROM --platform=linux/amd64 debian:bookworm-slim@sha256:f3034a6ec3c1205360777c4aae76234998866ad18806ae62b63a3f84ccad782b AS acquire
COPY node.tgz /node.tgz
COPY complete-generated-lock-sri.mjs complete-generated-lock-sri.test.mjs /owned/
COPY normalize-private-optional-platform-closure.mjs normalize-private-optional-platform-closure.test.mjs /owned/
COPY bootstrap-gentle-shell-private-node.sh acquire-gentle-shell-private-bundle.sh /owned/
RUN chmod 0444 /node.tgz /owned/*.mjs /owned/*.sh && \
    mkdir -m 0700 /acquire && chown 65532:65532 /acquire
USER 65532:65532
SHELL ["/bin/bash", "-c"]
# Stock guard executes before the provider and before its first stock Node probe.
RUN printf '%s\n' \
    'set -eu' \
    'test "$(cat /sys/fs/cgroup/memory.max)" = 3221225472' \
    'test "$(cat /sys/fs/cgroup/memory.swap.max)" = 0' \
    'test "$(cat /sys/fs/cgroup/cpu.max)" = "100000 100000"' \
    'printf "acquisition cgroup memory=3221225472 swap=0 cpu=100000/100000 verified\\n" > /acquire/limits.receipt' \
    > /acquire/limits.sh
ENV BASH_ENV=/acquire/limits.sh
# Aggregate kernel limits belong to this approved caller, not provider receipts.
RUN ulimit -t 240 && ulimit -u 64 && timeout --kill-after=5 450 \
    env -i PATH=/usr/bin:/bin HOME=/acquire /bin/sh /owned/acquire-gentle-shell-private-bundle.sh \
    --destination /acquire/published --node-archive /node.tgz
# Preserve the unchanged owned data-only helper tests using the accepted runtime.
RUN ulimit -t 60 && ulimit -u 64 && env -i HOME=/acquire PATH=/acquire/published/bundle/node/bin:/usr/bin:/bin \
    /acquire/published/bundle/node/bin/node --max-old-space-size=256 /owned/complete-generated-lock-sri.test.mjs
RUN ulimit -t 60 && ulimit -u 64 && env -i HOME=/acquire PATH=/acquire/published/bundle/node/bin:/usr/bin:/bin \
    /acquire/published/bundle/node/bin/node --max-old-space-size=256 /owned/normalize-private-optional-platform-closure.test.mjs
FROM --platform=linux/amd64 debian:bookworm-slim@sha256:f3034a6ec3c1205360777c4aae76234998866ad18806ae62b63a3f84ccad782b
ARG SOURCE_SHA
LABEL org.opencontainers.image.revision=$SOURCE_SHA
COPY --from=acquire /acquire/published/bundle /bundle
COPY --from=acquire /acquire/published/bundle-receipt /bundle-receipt
COPY --from=acquire /acquire/limits.receipt /acquisition-limits
COPY shell-linux-guest-proof.sh install-gentle-shell-private.sh shell-linux-private-runtime-guest.sh /usr/local/bin/
COPY normalize-private-optional-platform-closure.mjs complete-generated-lock-sri.mjs /usr/local/bin/
COPY --from=acquire /node.tgz /node.tgz
COPY bootstrap-gentle-shell-private-node.sh shell-linux-node-bootstrap-controls.sh /usr/local/bin/
COPY acquire-gentle-shell-private-bundle.sh shell-linux-bundle-acquisition-controls.sh /usr/local/bin/
RUN chmod 0444 /node.tgz /usr/local/bin/*.sh /usr/local/bin/*.mjs
ENTRYPOINT ["/bin/bash", "-c", "ulimit -t 240 && ulimit -u 64 && exec /bin/sh /usr/local/bin/shell-linux-bundle-acquisition-controls.sh"]
